# ──────────────────────────────────────────────────────────────────────────────
#  Configuración General de Jarvis (Plantilla de Ejemplo)
# ──────────────────────────────────────────────────────────────────────────────

# Tu nombre para el saludo (reemplazalo por el tuyo)
JARVIS_NOMBRE=TuNombreAqui

# URL de la canción o playlist de Spotify que va a sonar de fondo
JARVIS_SPOTIFY_URL=spotify:track:ACA_VA_EL_ID_DE_TU_CANCION

# Aplicaciones que se van a abrir en cadena (separadas por comas)
JARVIS_APPS=Code,Terminal,Chrome

# ──────────────────────────────────────────────────────────────────────────────
#  Sensibilidad del Micrófono
# ──────────────────────────────────────────────────────────────────────────────
# 0.03 es el valor recomendado por defecto
JARVIS_THRESHOLD=0.03

# ──────────────────────────────────────────────────────────────────────────────
#  Configuración de Voz 
# ──────────────────────────────────────────────────────────────────────────────
# [macOS] Voz por defecto
JARVIS_VOICE_MAC=Monica

# [Windows/Linux] Idioma de la voz 
JARVIS_VOICE_LANG=es

# Velocidad al hablar (148 es un ritmo natural)
JARVIS_VOICE_RATE=148